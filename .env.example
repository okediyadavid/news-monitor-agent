# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration
DB_PATH=data/news_monitor.db

# AI Configuration (Optional - for advanced natural language processing)
OPENAI_API_KEY=your_openai_api_key_here_here

# Application Configuration
CHECK_INTERVAL_HOURS=6
DATABASE_PATH=data/news_monitor.db
LOG_LEVEL=INFO
LOG_FILE=logs/news_monitor.log

# Scraping Configuration
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Concurrency Configuration
MAX_WORKERS=10
