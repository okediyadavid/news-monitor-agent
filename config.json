  "parsing_rules": {
    "default": {
      "article_selector": "article, .post, .entry",
      "title_selector": "h1, h2, .title, .headline",
      "link_selector": "a[href]",
      "date_selector": "time, .date, .published",
      "summary_selector": "p, .excerpt, .summary",
      "image_selector": "img[src]"
    }
  },
  "notification_settings": {
    "send_images": true,
    "max_summary_length": 500,
    "batch_notifications": false,
    "notification_template": "📰 New Article\n\nSource: {source}\nTitle: {title}\nPublished: {date}\nSummary: {summary}\n\nRead more: {url}"
  }
}
